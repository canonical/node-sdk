cat <<EOF >/etc/profile.d/nodejs.sh
export PATH="$SDK/bin:\$PATH"
EOF

# shellcheck source=/dev/null
. /etc/profile.d/nodejs.sh
node --completion-bash > /etc/bash_completion.d/node_bash_completion
npm completion > /etc/bash_completion.d/npm

sudo --login --user=workshop -- npm config set prefix '${HOME}/.local'
# Required for npx (or npm exec).
sudo --login --user=workshop -- mkdir -p /home/workshop/.local/lib
